{
  "name": "@siemsiem/beerreact",
  "version": "3.0.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/index.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/index.css",
    "./index.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build --config vite.config.ts && bun run build:types",
    "build:lib": "vite build --config vite.config.ts && bun run build:types",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build:demo": "vite build --config example/vite.config.ts",
    "deploy:demo": "bun run build:demo && bunx netlify deploy --dir=demo-dist --prod",
    "demo": "vite --config example/vite.config.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-onboarding": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "netlify-cli": "^27.10.0",
    "playwright": "^1.63.0",
    "react-router-dom": "^7.18.4",
    "storybook": "^10.6.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "beercss": "^5.0.3",
    "chromatic": "^17.8.0",
    "material-dynamic-colors": "^1.1.4"
  }
}